{
  "name": "imgpro",
  "version": "1.1.2",
  "description": "Desktop app for manipulating images.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && npx esbuild src/renderer/renderer.ts --bundle --outfile=dist/renderer/renderer.js --platform=browser && shx cp src/renderer/index.html dist/renderer/index.html && shx cp src/renderer/style.css dist/renderer/style.css && shx cp src/renderer/icon.png dist/renderer/icon.png",
    "start": "pnpm run build && electron .",
    "watch": "tsc -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:all": "pnpm run build && electron-builder -mwl"
  },
  "keywords": [],
  "author": "",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.26.1",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "2.0.0-alpha.1",
    "esbuild": "^0.28.1",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@imgly/background-removal-node": "^1.4.5",
    "jszip": "^3.10.1",
    "lucide": "^1.24.0",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.imgpro.app",
    "productName": "IMGpro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Graphics"
    }
  }
}
